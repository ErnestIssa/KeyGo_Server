# Required in production (Render). Optional locally — dev falls back to mongodb://127.0.0.1:27017/keygo if unset.
MONGO_URI=mongodb://127.0.0.1:27017/keygo

# Render sets PORT automatically. For local dev you can set:
# PORT=3000

# Bind address (default 0.0.0.0 — correct for Render and LAN)
# HOST=0.0.0.0

# Production: your deployed frontend origin(s), comma-separated if needed
# CORS_ORIGIN=https://your-frontend.onrender.com

# When CORS_ORIGIN is set, also allow local Vite (5173) and preview (4173) for testing against prod API
# CORS_INCLUDE_LOCALHOST=true

# NODE_ENV=production

# --- WebRTC (calls: voice / video) ---
# Optional: override STUN (comma-separated URLs). Default: Google public STUN.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# TURN (recommended for production / symmetric NAT). All three required to add TURN.
# WEBRTC_TURN_URL=turns:turn.example.com:5349?transport=tcp
# WEBRTC_TURN_USERNAME=keygo
# WEBRTC_TURN_CREDENTIAL=your-turn-secret

# Or pass full RTCPeerConnection config as JSON (overrides STUN/TURN vars if valid):
# WEBRTC_ICE_SERVERS_JSON={"iceServers":[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]}

# Call limits (optional)
# CALL_RING_TIMEOUT_MS=120000
# CALL_MAX_DURATION_MS=14400000
# CALL_RATE_LIMIT_PER_MIN=15
